               scriptText = "if [ -f &quot;$SRCROOT/Flutter/flutter_export_environment.sh&quot; ]; then&#10;  . &quot;$SRCROOT/Flutter/flutter_export_environment.sh&quot;&#10;fi&#10;if [ -z &quot;$FLUTTER_ROOT&quot; ] &amp;&amp; [ -f &quot;$SRCROOT/Flutter/Generated.xcconfig&quot; ]; then&#10;  export FLUTTER_ROOT=$(grep -E '^FLUTTER_ROOT=' &quot;$SRCROOT/Flutter/Generated.xcconfig&quot; | cut -d'=' -f2-)&#10;fi&#10;if [ ! -f &quot;$FLUTTER_ROOT/packages/flutter_tools/bin/xcode_backend.sh&quot; ]; then&#10;  if command -v flutter &gt;/dev/null 2&gt;&amp;1; then&#10;    export FLUTTER_ROOT=&quot;$(dirname &quot;$(dirname &quot;$(which flutter)&quot;)&quot;)&quot;&#10;  elif [ -d &quot;$HOME/Downloads/flutter&quot; ]; then&#10;    export FLUTTER_ROOT=&quot;$HOME/Downloads/flutter&quot;&#10;  elif [ -d &quot;$HOME/flutter&quot; ]; then&#10;    export FLUTTER_ROOT=&quot;$HOME/flutter&quot;&#10;  elif [ -d &quot;$HOME/development/flutter&quot; ]; then&#10;    export FLUTTER_ROOT=&quot;$HOME/development/flutter&quot;&#10;  fi&#10;fi&#10;if [ -n &quot;$FLUTTER_ROOT&quot; ] &amp;&amp; [ -f &quot;$FLUTTER_ROOT/packages/flutter_tools/bin/xcode_backend.sh&quot; ]; then&#10;  /bin/sh &quot;$FLUTTER_ROOT/packages/flutter_tools/bin/xcode_backend.sh&quot; prepare&#10;fi&#10;">
